<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f4f6fb;
        }

        /* MAIN LAYOUT */

        .layout {
            display: flex;
            height: 100vh;
        }

        /* SIDEBAR */

        .sidebar {
            width: 230px;
            background: white;
            height: 100vh;
            padding: 25px;
            border-right: 1px solid #eee;
        }

        .logo {
            margin-bottom: 30px;
        }

        .sidebar ul {
            list-style: none;
        }

        .sidebar ul li {
            padding: 12px;
            margin-bottom: 8px;
            border-radius: 8px;
            cursor: pointer;
        }

        .sidebar ul li a {
            text-decoration: none;
            color: black;
        }

        .sidebar ul li:hover {
            background: #f1f2f6;
        }

        .active {
            background: #f1f2f6;
            font-weight: 600;
        }

        .sidebar-bottom {
            position: absolute;
            bottom: 20px;
            font-size: 14px;
        }

        /* MAIN CONTENT */

        .main {
            flex: 1;
            padding: 30px;
        }

        /* TOPBAR */

        .topbar {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
        }

        .menu a {
            margin-right: 20px;
            color: #555;
            cursor: pointer;
            text-decoration: none;
        }

        #activee {
            font-weight: bold;
            color: rgb(247, 126, 126);
        }

        .top-right {
            display: flex;
            gap: 15px;
        }

        .top-right input {
            padding: 8px 12px;
            border-radius: 6px;
            border: 1px solid #ddd;
        }

        .download {
            background: #111827;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 8px;
            cursor: pointer;
        }

        /* HERO CARD */

        .hero-card {
            background: white;
            padding: 30px;
            border-radius: 12px;
            max-width: 800px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        }

        .hero-card h2 {
            margin-bottom: 25px;
            font-size: 22px;
        }

        /* TWO COLUMN FORM */

        .form-grid {
            display: flex;
            gap: 25px;
        }

        .form-left,
        .form-right {
            flex: 1;
        }

        /* FORM */

        .form-row {
            margin-bottom: 18px;
            display: flex;
            flex-direction: column;
        }

        .form-row label {
            font-weight: 600;
            margin-bottom: 6px;
        }

        .form-row input,
        .form-row textarea {
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #ddd;
            font-size: 14px;
        }

        .form-row textarea {
            resize: none;
            height: 90px;
        }

        .form-row input:focus,
        .form-row textarea:focus {
            outline: none;
            border-color: #6366f1;
        }

        .submit-btn {
            margin-top: 10px;
            padding: 12px;
            border: none;
            background: #6366f1;
            color: white;
            font-size: 15px;
            border-radius: 8px;
            cursor: pointer;
        }

        .submit-btn:hover {
            background: #4f46e5;
        }

        #AddHeroSection {
            padding-bottom: 2%;
            padding-top: 1%;
        }
    </style>

</head>

<body>

    <div class="layout">

        <!-- SIDEBAR -->

        <div class="sidebar">

            <h2 class="logo">Shadcn Admin</h2>

            <ul>
                <li><a href="/admin/panel">Dashboard</a></li>
                <li class="active"><a href="/admin/addcourse">Courses</a></li>
                <li><a href="">Orders</a></li>

                <!-- <li>Apps</li> -->
                <li>Chats</li>
                <li>Users</li>
            </ul>

            <div class="sidebar-bottom">
                <p>satnaing</p>
                <span>satnaingdev@gmail.com</span>
            </div>

        </div>

        <!-- MAIN -->

        <div class="main">

            <!-- TOP NAVBAR -->

            <div class="topbar">

                <div class="menu">
                     <a href="/admin/allcourse">Courses</a>
                    <a href="/admin/addcourse">Add Course</a>
                    <a id="activee" href="/admin/addthumbanile">Set Thumbnail</a>
  <a href="/admin/addreview" >Add Reviews</a>
                    <a href="">Settings</a>
                </div>

                <div class="top-right">
                    <input type="text" placeholder="Search">
                    <button class="download">Download</button>
                </div>

            </div>

            <!-- HERO FORM -->

            <h2 id="AddHeroSection">Add Hero Section</h2>
            <div class="hero-card">


                <form action="/admin/addthumbanile" method="POST" enctype="multipart/form-data">

                    <div class="form-grid">

                        <!-- LEFT SIDE -->

                        <div class="form-left">

                            <div class="form-row">
                                <label>Hero Title</label>
                                <input type="text" name="heroTitle" placeholder="Enter hero title" required>
                            </div>

                            <div class="form-row">
                                <label>Hero Subtitle</label>
                                <textarea name="heroSubtitle" placeholder="Enter hero subtitle" required></textarea>
                            </div>


                            <div class="form-row">
                                <label>Button Text</label>
                                <input type="text" name="buttonText" placeholder="Start Learning">
                            </div>



                        </div>

                        <!-- RIGHT SIDE -->

                        <div class="form-right">

                            <div class="form-row">
                                <label>Old Price</label>
                                <input type="text" name="oldprice" placeholder="Enter old price" required>
                            </div>

                            <div class="form-row">
                                <label>Offer Price</label>
                                <input type="text" name="offerprice" placeholder="Enter offer price" required>
                            </div>



                            <div class="form-row">
                                <label>Hero Thumbnail Image</label>
                                <input type="file" name="heroThumbnailImage" required>
                            </div>

                        </div>

                    </div>

                    <button class="submit-btn">Upload Hero Section</button>

                </form>

            </div>

        </div>

    </div>

</body>

</html>