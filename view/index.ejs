    <!-- Swiper JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <script>
        // Initialize Swiper for Essential Skills Slider
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof Swiper !== "undefined") {
                const skillsSwiper = new Swiper(".skillsSwiper", {
                    slidesPerView: 1,
                    spaceBetween: 20,
                    loop: true,
                    grabCursor: true,
                    navigation: {
                        nextEl: ".skills-btn-next",
                        prevEl: ".skills-btn-prev",
                    },
                    pagination: {
                        el: ".skills-swiper-pagination",
                        clickable: true,
                        dynamicBullets: true,
                    },
                    breakpoints: {
                        560: {
                            slidesPerView: 1.4,
                            spaceBetween: 20,
                        },
                        820: {
                            slidesPerView: 1.8,
                            spaceBetween: 24,
                        },
                        1100: {
                            slidesPerView: 2.2,
                            spaceBetween: 24,
                        }
                    }
                });
            }
        });

        // Accordion Toggle
        function toggleAccordion(btn) {
            const item = btn.closest('.accordion-item');
            const isActive = item.classList.contains('active');
            
            // Close siblings in same list
            const parentList = item.parentElement;
            parentList.querySelectorAll('.accordion-item').forEach(el => {
                el.classList.remove('active');
            });

            if (!isActive) {
                item.classList.add('active');
            }
        }

        // Live Course Search Filter
        function filterCourses() {
            const query = document.getElementById("courseSearchInput").value.toLowerCase();
            const cards = document.querySelectorAll("#coursesGrid .course-card-premium");

            cards.forEach(card => {
                const name = card.getAttribute("data-course-name") || "";
                const instructor = card.getAttribute("data-instructor") || "";
                if (name.includes(query) || instructor.includes(query)) {
                    card.style.display = "flex";
                } else {
                    card.style.display = "none";
                }
            });
        }

        // Category Filter
        function filterCategory(cat, btn) {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const cards = document.querySelectorAll("#coursesGrid .course-card-premium");
            cards.forEach(card => {
                const name = card.getAttribute("data-course-name") || "";
                if (cat === 'all') {
                    card.style.display = 'flex';
                } else if (name.includes(cat)) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Wishlist Heart Toggle
        function toggleFavorite(btn) {
            btn.classList.toggle('liked');
            const svg = btn.querySelector('svg');
            if (btn.classList.contains('liked')) {
                svg.setAttribute('fill', '#e53e3e');
                svg.setAttribute('stroke', '#e53e3e');
            } else {
                svg.setAttribute('fill', 'none');
                svg.setAttribute('stroke', 'currentColor');
            }
        }
    </script>
</body>

