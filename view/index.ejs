<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eductix – Online Learning & Career Growth Platform</title>
    <meta name="description" content="Eductix is a clean, conversion-focused online courses platform designed to build skills that shape your career.">

    <!-- Google Fonts: Geist & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <!-- Eductix Design System Stylesheet -->
    <link rel="stylesheet" href="/css/eductix.css">

    <style>
        /* Interactive Elements & Custom Touches for index page */
        .category-filter-bar {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 36px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: var(--eductix-white);
            color: var(--eductix-muted);
            border: 1px solid var(--eductix-border-subtle);
            padding: 8px 20px;
            border-radius: var(--radius-pill);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .filter-btn:hover,
        .filter-btn.active {
            background: var(--eductix-forest);
            color: var(--eductix-white);
            border-color: var(--eductix-forest);
        }

        /* Swiper Arrows */
        .swiper-nav-row {
            display: flex;
            gap: 12px;
        }

        .swiper-arrow-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--eductix-white);
            border: 1px solid var(--eductix-border-subtle);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--eductix-forest);
            font-size: 18px;
            transition: all 0.2s ease;
        }

        .swiper-arrow-btn:hover {
            background: var(--eductix-emerald);
            color: white;
            border-color: var(--eductix-emerald);
        }

        /* Client rating card */
        .floating-rating-badge {
            position: absolute;
            bottom: 24px;
            left: 24px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border-radius: 16px;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: 0 10px 30px rgba(0, 59, 45, 0.12);
            border: 1px solid rgba(0, 59, 45, 0.08);
            z-index: 2;
        }

        .rating-stars {
            color: #f59e0b;
            font-size: 14px;
            letter-spacing: 2px;
        }

        .rating-score {
            font-family: var(--font-heading);
            font-size: 20px;
            font-weight: 700;
            color: var(--eductix-forest);
            line-height: 1;
        }

        .rating-label {
            font-size: 12px;
            color: var(--eductix-muted);
        }

        /* Hero tag pills floating */
        .hero-floating-tag {
            position: absolute;
            background: var(--eductix-card-mint);
            border: 1px solid rgba(0, 59, 45, 0.12);
            padding: 8px 18px;
            border-radius: 50px;
            font-size: 13.5px;
            font-weight: 600;
            color: var(--eductix-forest);
            box-shadow: 0 8px 24px rgba(0, 59, 45, 0.08);
            backdrop-filter: blur(10px);
            z-index: 3;
            transition: transform 0.3s ease;
        }

        .hero-floating-tag:hover {
            transform: scale(1.05);
        }
    </style>
</head>

<body>

    <!-- TOP OFFER BAR -->
    <div class="eductix-offer-bar">
        <span class="badge">New</span>
        <span>Build in-demand skills with practical online courses & verified certificates.</span>
        <a href="#course-section" style="text-decoration: underline; color: #fff; font-weight: 600;">Explore Now →</a>
    </div>

    <!-- FLOATING NAVBAR -->
    <header class="eductix-nav-wrapper">
        <nav class="eductix-nav">
            <!-- Brand Logo -->
            <a href="/" class="eductix-brand">
                Ezuca<span class="brand-dot"></span>
            </a>

            <!-- Navigation Links -->
            <ul class="eductix-nav-links">
                <li><a href="/" class="active">Home</a></li>
                <li><a href="#course-section">Courses</a></li>
                <li><a href="#program-section">Programs</a></li>
                <li><a href="#work-section">Why Us</a></li>
                <li><a href="#pricing-section">Pricing</a></li>
                <li><a href="#faq-section">FAQ</a></li>
            </ul>

            <!-- Search Bar -->
            <div class="eductix-search-pill">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" id="courseSearchInput" placeholder="Search courses..." onkeyup="filterCourses()">
            </div>

            <!-- Action Buttons -->
            <div class="eductix-nav-actions">
                <!-- Cart Button -->
                <a href="/cart" class="eductix-icon-btn" title="View Cart">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <span class="badge-count">Cart</span>
                </a>

                <!-- Profile Link -->
                <a href="/user/profile" class="eductix-icon-btn" title="User Profile">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </a>

                <!-- Auth Buttons -->
                <a href="/userlogin" class="btn-eductix-outline">Log in</a>
                <a href="#course-section" class="btn-eductix-primary">
                    <span>Explore</span>
                    <span class="icon-circle">↗</span>
                </a>
            </div>
        </nav>
    </header>

    <!-- HERO SECTION -->
    <section class="eductix-hero" id="hero">
        <!-- Ambient Glowing Background Mesh -->
        <div class="eductix-ambient-canvas">
            <div class="eductix-glow-orb glow-orb-forest"></div>
            <div class="eductix-glow-orb glow-orb-emerald"></div>
            <div class="eductix-glow-orb glow-orb-purple"></div>
        </div>

        <div class="eductix-container">
            <div class="eductix-hero-grid">
                <!-- Left Column -->
                <div class="eductix-hero-content">
                    <div class="pill-badge">
                        <span class="pill-dot"></span>
                        Built for real growth & careers
                    </div>

                    <h1 class="eductix-hero-title">
                        Build Skills That Shape Your Future
                    </h1>

                    <p class="eductix-hero-subtitle">
                        Practical online courses designed to help you gain real-world experience, master in-demand technology, and grow with confidence.
                    </p>

                    <div class="eductix-hero-cta-group">
                        <a href="#course-section" class="btn-eductix-primary">
                            <span>Explore Courses</span>
                            <span class="icon-circle">↗</span>
                        </a>
                        <a href="#pricing-section" class="btn-eductix-secondary">
                            <span>View Plans</span>
                        </a>
                    </div>

                    <!-- Micro Feature Box -->
                    <div class="eductix-feature-mini-card">
                        <div class="eductix-feature-mini-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                                <path d="M2 17l10 5 10-5"></path>
                                <path d="M2 12l10 5 10-5"></path>
                            </svg>
                        </div>
                        <div class="eductix-feature-mini-text">
                            <h5>Follow Guided Paths</h5>
                            <p>Structured curriculum from beginner level to industry job-ready mastery.</p>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Framer Eductix Showcase Cluster -->
                <div class="eductix-hero-visual">
                    <!-- Showcase Card 1: Main Banner Visual -->
                    <div class="showcase-card card-large">
                        <img src="/images/edubackground02.jpg" alt="Learning Experience" onerror="this.src='/images/ddd.png'">
                    </div>

                    <!-- Showcase Card 2: Emerald Highlight Quote -->
                    <div class="showcase-card card-emerald">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span class="pill-badge" style="background: rgba(255,255,255,0.25); color: #fff; border: none; font-size: 11px;">Best Choice</span>
                            <span style="font-size: 20px;">★ ★ ★ ★ ★</span>
                        </div>
                        <p style="font-size: 15px; font-weight: 500; line-height: 1.4; color: #fff;">
                            "Hands-on lessons that helped me apply skills right away in real projects."
                        </p>
                    </div>

                    <!-- Showcase Card 3: Deep Forest Stat Card -->
                    <div class="showcase-card card-forest">
                        <div>
                            <span style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: #92b8a7; font-weight: 700;">Curriculum</span>
                            <h3 style="font-family: var(--font-heading); font-size: 42px; font-weight: 800; color: #fff; line-height: 1.1; margin-top: 4px;">62+</h3>
                        </div>
                        <p style="font-size: 13.5px; color: #d0e6dc;">
                            Courses built around real-world projects and portfolio creation.
                        </p>
                    </div>

                    <!-- Showcase Card 4: Interactive Classrooms Card -->
                    <div class="showcase-card card-col2-tall">
                        <img src="/images/edubackground01.jpg" alt="Interactive Classrooms" onerror="this.src='/images/itpro.jpg'">
                        <div class="overlay-text">
                            Interactive Classrooms & Live Mentorship
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- TRUSTED BRAND TICKER -->
    <section class="eductix-ticker-section">
        <p class="eductix-ticker-title">Trusted by learners and educators worldwide</p>
        <div class="eductix-ticker-track">
            <!-- Set 1 -->
            <div class="ticker-item"><span class="ticker-dot"></span> Google Cloud Partner</div>
            <div class="ticker-item"><span class="ticker-dot"></span> Amazon AWS Certified</div>
            <div class="ticker-item"><span class="ticker-dot"></span> Microsoft Learn</div>
            <div class="ticker-item"><span class="ticker-dot"></span> Meta Developer Community</div>
            <div class="ticker-item"><span class="ticker-dot"></span> IBM SkillsBuild</div>
            <div class="ticker-item"><span class="ticker-dot"></span> Harvard edX Standards</div>
            <div class="ticker-item"><span class="ticker-dot"></span> Stanford Online Aligned</div>
            <!-- Set 2 (for infinite loop) -->
            <div class="ticker-item"><span class="ticker-dot"></span> Google Cloud Partner</div>
            <div class="ticker-item"><span class="ticker-dot"></span> Amazon AWS Certified</div>
            <div class="ticker-item"><span class="ticker-dot"></span> Microsoft Learn</div>
            <div class="ticker-item"><span class="ticker-dot"></span> Meta Developer Community</div>
            <div class="ticker-item"><span class="ticker-dot"></span> IBM SkillsBuild</div>
            <div class="ticker-item"><span class="ticker-dot"></span> Harvard edX Standards</div>
            <div class="ticker-item"><span class="ticker-dot"></span> Stanford Online Aligned</div>
        </div>
    </section>

    <!-- ABOUT / STATS COUNTER SECTION -->
    <section class="eductix-stats-section" id="about">
        <div class="eductix-container">
            <div class="eductix-hero-grid" style="margin-bottom: 60px;">
                <div>
                    <span class="section-tagline">Why Eductix</span>
                    <h2 class="section-title">Learning Built for Real Careers</h2>
                    <p class="section-desc">
                        Eductix is a modern online learning platform focused on practical, skill-based education. We bridge the gap between academic theory and market requirements.
                    </p>
                    <div style="margin-top: 32px;">
                        <a href="#program-section" class="btn-eductix-primary">
                            <span>Explore Programs</span>
                            <span class="icon-circle">↗</span>
                        </a>
                    </div>
                </div>

                <!-- Right Visual with Floating Tags -->
                <div style="position: relative; height: 380px; border-radius: var(--radius-card); overflow: hidden; box-shadow: var(--eductix-card-shadow);">
                    <img src="/images/edubackground03.jpg" alt="Student Success" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/cornergirl.png'">

                    <!-- Floating Pill Badges -->
                    <div class="hero-floating-tag" style="top: 30px; left: 30px; transform: rotate(-4deg);">
                        Digital Marketing
                    </div>
                    <div class="hero-floating-tag" style="top: 140px; right: 30px; transform: rotate(5deg); background: var(--eductix-emerald); color: white;">
                        Web Development
                    </div>
                    <div class="hero-floating-tag" style="bottom: 90px; left: 40px; transform: rotate(-2deg);">
                        Data Analytics
                    </div>

                    <!-- Client Rating Badge -->
                    <div class="floating-rating-badge">
                        <div class="rating-stars">★★★★★</div>
                        <div>
                            <div class="rating-score">4.9 / 5.0</div>
                            <div class="rating-label">Average Student Rating</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Row -->
            <div class="eductix-stats-box">
                <div class="stat-item">
                    <div class="stat-number">95%</div>
                    <div class="stat-label">Learner Satisfaction</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">120+</div>
                    <div class="stat-label">Courses Available</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">30K+</div>
                    <div class="stat-label">Active Learners</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">50+</div>
                    <div class="stat-label">Countries Reached</div>
                </div>
            </div>
        </div>
    </section>

    <!-- FEATURED PROGRAMS HIGHLIGHT -->
    <section class="eductix-section" id="program-section">
        <div class="eductix-container">
            <div class="section-header">
                <span class="section-tagline">Pathways to Success</span>
                <h2 class="section-title">Explore Career-Focused Programs</h2>
                <p class="section-desc">Choose from expertly designed tracks built around high-impact, real-world skills.</p>
            </div>

            <div class="programs-grid">
                <!-- Program 1 -->
                <div class="program-card-wrap">
                    <div class="program-card-inner">
                        <div class="program-icon-badge">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                            </svg>
                        </div>
                        <div class="program-content">
                            <h4>Digital Marketing</h4>
                            <p>Master SEO, performance marketing, paid ads, content strategy, and analytics for hyper growth.</p>
                        </div>
                        <a href="#course-section" class="btn-eductix-outline" style="align-self: flex-start;">Explore Courses →</a>
                    </div>
                </div>

                <!-- Program 2 -->
                <div class="program-card-wrap">
                    <div class="program-card-inner">
                        <div class="program-icon-badge" style="background: var(--eductix-forest);">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="16 18 22 12 16 6"></polyline>
                                <polyline points="8 6 2 12 8 18"></polyline>
                            </svg>
                        </div>
                        <div class="program-content">
                            <h4>Web Development</h4>
                            <p>Build modern frontend apps, robust backend APIs, scalable databases, and fullstack cloud architectures.</p>
                        </div>
                        <a href="#course-section" class="btn-eductix-outline" style="align-self: flex-start;">Explore Courses →</a>
                    </div>
                </div>

                <!-- Program 3 -->
                <div class="program-card-wrap">
                    <div class="program-card-inner">
                        <div class="program-icon-badge">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                <line x1="6" y1="20" x2="6" y2="14"></line>
                            </svg>
                        </div>
                        <div class="program-content">
                            <h4>Data & AI Analytics</h4>
                            <p>Transform raw datasets into actionable insights with Python, SQL, PowerBI, and cutting-edge machine learning.</p>
                        </div>
                        <a href="#course-section" class="btn-eductix-outline" style="align-self: flex-start;">Explore Courses →</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ESSENTIAL SKILLS SHOWCASE SECTION (PROPER SIDE-BY-SIDE EDUCTIX DESIGN) -->
    <section class="skills-showcase-section" id="skills-section">
        <div class="eductix-container">
            <div class="skills-showcase-grid">
                <!-- Left Content Column -->
                <div class="skills-text-side">
                    <div class="pill-badge">
                        <span class="pill-dot"></span> In-Demand Skills
                    </div>

                    <h2 class="section-title">
                        Learn Essential Career & Life Skills
                    </h2>

                    <p class="section-desc" style="font-size: 16px;">
                        Build in-demand skills fast and advance your career. Follow guided learning tracks curated by real-world industry experts to gain practical confidence.
                    </p>

                    <ul class="skills-features-list">
                        <li>
                            <span class="bullet-dot">✓</span>
                            <span>Hands-on project-based roadmaps</span>
                        </li>
                        <li>
                            <span class="bullet-dot">✓</span>
                            <span>Expert mentorship & real-time feedback</span>
                        </li>
                        <li>
                            <span class="bullet-dot">✓</span>
                            <span>Recognized career certification upon completion</span>
                        </li>
                    </ul>

                    <!-- Controls and CTA -->
                    <div class="skills-nav-row">
                        <button class="skills-arrow-btn skills-btn-prev" aria-label="Previous slide">←</button>
                        <button class="skills-arrow-btn skills-btn-next" aria-label="Next slide">→</button>
                        <a href="#course-section" class="btn-eductix-primary" style="margin-left: 10px;">
                            <span>Explore All</span>
                            <span class="icon-circle">↗</span>
                        </a>
                    </div>
                </div>

                <!-- Right Slider Column -->
                <div class="skills-slider-side">
                    <div class="swiper skillsSwiper">
                        <div class="swiper-wrapper">
                            <% if (typeof thumbanile !== 'undefined' && thumbanile && thumbanile.length > 0) { %>
                                <% for(let i = 0; i < thumbanile.length; i++) { %>
                                    <div class="swiper-slide">
                                        <div class="skills-card">
                                            <img src="/images/<%= thumbanile[i].heroThumbnailImage %>" alt="<%= thumbanile[i].heroTitle %>" onerror="this.src='/images/edubackground02.jpg'">
                                            <div class="skills-card-gradient"></div>
                                            <div class="skills-floating-bottom">
                                                <span class="skills-card-title-text"><%= thumbanile[i].heroTitle %></span>
                                                <span class="skills-card-arrow-circle">→</span>
                                            </div>
                                        </div>
                                    </div>
                                <% } %>
                            <% } else { %>
                                <!-- Fallback high quality skills cards -->
                                <div class="swiper-slide">
                                    <div class="skills-card">
                                        <img src="/images/edubackground02.jpg" alt="Full Stack Web Development">
                                        <div class="skills-card-gradient"></div>
                                        <div class="skills-floating-bottom">
                                            <span class="skills-card-title-text">Full Stack Web Development</span>
                                            <span class="skills-card-arrow-circle">→</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="swiper-slide">
                                    <div class="skills-card">
                                        <img src="/images/edubackground01.jpg" alt="Data Science & Machine Learning">
                                        <div class="skills-card-gradient"></div>
                                        <div class="skills-floating-bottom">
                                            <span class="skills-card-title-text">Data Science & AI Analytics</span>
                                            <span class="skills-card-arrow-circle">→</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="swiper-slide">
                                    <div class="skills-card">
                                        <img src="/images/itpro.jpg" alt="UI/UX Product Design">
                                        <div class="skills-card-gradient"></div>
                                        <div class="skills-floating-bottom">
                                            <span class="skills-card-title-text">UI/UX Product Design</span>
                                            <span class="skills-card-arrow-circle">→</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="swiper-slide">
                                    <div class="skills-card">
                                        <img src="/images/edubackground03.jpg" alt="Cloud Architecture & DevOps">
                                        <div class="skills-card-gradient"></div>
                                        <div class="skills-floating-bottom">
                                            <span class="skills-card-title-text">Cloud & DevOps Engineering</span>
                                            <span class="skills-card-arrow-circle">→</span>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                        <div class="swiper-pagination skills-swiper-pagination"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- DYNAMIC COURSES SECTION (CORE MONGODB DATA) -->
    <section class="eductix-section" id="course-section">
        <div class="eductix-container">
            <div class="section-header text-center">
                <span class="section-tagline">Explore Our Curriculum</span>
                <h2 class="section-title">Skills to Transform Your Career & Life</h2>
                <p class="section-desc">From critical engineering skills to business strategies, support your professional development with verified mentorship.</p>
            </div>

            <!-- Category Filter Bar -->
            <div class="category-filter-bar">
                <button class="filter-btn active" onclick="filterCategory('all', this)">All Courses</button>
                <button class="filter-btn" onclick="filterCategory('web', this)">Web & Software</button>
                <button class="filter-btn" onclick="filterCategory('data', this)">Data & AI</button>
                <button class="filter-btn" onclick="filterCategory('design', this)">UI/UX Design</button>
                <button class="filter-btn" onclick="filterCategory('marketing', this)">Marketing</button>
            </div>

            <!-- Dynamic Courses Grid -->
            <div class="courses-grid" id="coursesGrid">
                <% if (course && course.length > 0) { %>
                    <% for(let i=0; i < course.length; i++) { %>
                        <div class="course-card-premium" data-course-name="<%= course[i].courseName ? course[i].courseName.toLowerCase() : '' %>" data-instructor="<%= course[i].Instructor ? course[i].Instructor.toLowerCase() : '' %>">
                            <!-- Course Thumbnail -->
                            <div class="course-card-thumb">
                                <img src="/images/<%= course[i].coursesthumbnailImage %>" alt="<%= course[i].courseName %>" onerror="this.src='/images/edubackground01.jpg'">
                                <span class="course-badge-top">
                                    ⏱ <%= course[i].courseDuration || 'Self-paced' %>
                                </span>
                                <span class="course-badge-price">
                                    ₹<%= course[i].courseFee %>
                                </span>
                            </div>

                            <!-- Course Body -->
