<!DOCTYPE html>
<html>

<head>
    <title>Add Course</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial;
        }

        body {
            background: #f5f6fa;
        }

        /* MAIN LAYOUT */
        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */

        .sidebar {
            width: 230px;
            background: white;
            height: 100vh;
            padding: 25px;
            border-right: 1px solid #eee;

            position: fixed;
            left: 0;
            top: 0;
        }

        .logo {
            margin-bottom: 30px;
        }

        .sidebar ul {
            list-style: none;
        }

        .sidebar ul li {
            padding: 12px;
            margin-bottom: 8px;
            border-radius: 8px;
            cursor: pointer;
        }

        .sidebar ul li:hover {
            background: #f1f2f6;
        }


        .active {
            background: #f1f2f6;
            font-weight: 600;

        }

        #activee {
            font-weight: bold;
            color: rgb(247, 126, 126);
        }

        .sidebar-bottom {
            position: absolute;
            bottom: 20px;
            left: 25px;
            font-size: 14px;
        }

        /* MAIN */
        .main {
            flex: 1;
            padding: 30px;
            margin-left: 230px;
        }

        /* TOPBAR */

        .topbar {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
        }

        .menu a {
            margin-right: 20px;
            color: #555;
            cursor: pointer;
            text-decoration: none;
        }

        .top-right {
            display: flex;
            gap: 15px;
        }

        .top-right input {
            padding: 8px 12px;
            border-radius: 6px;
            border: 1px solid #ddd;
        }

        .download {
            background: #2257d3;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
        }

        /* COURSE FORM */

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .draft {
            padding: 10px 15px;
            border: 1px solid #ccc;
            background: white;
            border-radius: 8px;
        }

        .add {
            padding: 10px 18px;
            background: #4CAF50;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

        .grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
        }

        .box {
            background: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .box h3 {
            margin-bottom: 15px;
        }

        input,
        textarea,
        select {
            width: 100%;
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 6px;
            border: 1px solid #ddd;
        }

        textarea {
            height: 100px;
        }

        .levellabel {
            font-size: 18px;
            font-weight: bold;


        }

        .level {
            display: flex;
            gap: 20px;
            margin-top: 8px;
        }


        .sidebar ul li a {
            text-decoration: none;
            color: black;
        }











        /* MODAL BACKGROUND */

        .modal {
            display: none;
            position: fixed;
            z-index: 999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(4px);
        }

        /* MODAL BOX */

        .modal-content {
            width: 420px;
            background: white;
            margin: 120px auto;
            padding: 35px;
            border-radius: 12px;
            position: relative;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.15);
            animation: modalSlide 0.4s ease;
        }

        /* ANIMATION */

        @keyframes modalSlide {
            from {
                transform: translateY(-60px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        /* CLOSE BUTTON */

        .close {
            position: absolute;
            right: 18px;
            top: 15px;
            font-size: 22px;
            cursor: pointer;
            color: #888;
            transition: 0.3s;
        }

        .close:hover {
            color: #ff4d4d;
        }

        /* TITLE */

        .modal-content h2 {
            margin-bottom: 25px;
            text-align: center;
            color: #333;
        }

        /* FORM */

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: 500;
            color: #555;
        }

        /* INPUT */

        .form-group input {
            width: 100%;
            padding: 12px;
            border-radius: 6px;
            border: 1px solid #ddd;
            outline: none;
            font-size: 14px;
            transition: 0.3s;
        }

        .form-group input:focus {
            border-color: #4a90e2;
            box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.15);
        }

        /* BUTTON */

        .submit-btn {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 6px;
            background: linear-gradient(135deg, #4a90e2, #6a5cff);
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.15);
        }


        /* CATEGORY LIST */

        .inputsss {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 14px;
            margin-top: 10px;
            background: #f7f8fc;
            border-radius: 6px;
            border: 1px solid #e6e8f0;
            transition: 0.3s;
        }

        /* hover effect */

        .inputsss:hover {
            background: #eef1ff;
        }

        /* category text */

        .inputsss span {
            font-size: 14px;
            font-weight: 500;
            color: #333;
        }

        /* delete button */

        .inputsss a {
            text-decoration: none;
            font-size: 13px;
            padding: 5px 10px;
            border-radius: 4px;
            background: #ff4d4d;
            color: white;
            transition: 0.3s;
        }

        /* delete hover */

        .inputsss a:hover {
            background: #e63939;
        }
    </style>
</head>

<body>

    <div class="layout">

        <!-- SIDEBAR -->

        <div class="sidebar">

            <h2 class="logo">Admin</h2>

            <ul>
                <li><a href="/admin/panel">Dashboard</a></li>
                <li class="active"><a href="/admin/addcourse">Courses</a></li>
                <li><a href="">Orders</a></li>
                <li>Chats</li>
                <li>Users</li>
            </ul>

            <div class="sidebar-bottom">
                <p>satnaing</p>
                <span>satnaingdev@gmail.com</span>
            </div>

        </div>



        <!-- MAIN -->

        <div class="main">

            <div class="topbar">

                <div class="menu">
                    <a href="/admin/allcourse">Courses</a>
                    <a href="/admin/addcourse" id="activee">Add Course</a>
                    <a href="/admin/addthumbanile">Set Thumbnail</a>
                    <a href="/admin/addreview">Add Reviews</a>
                    <a>Settings</a>
                </div>

                <div class="top-right">
                    <input type="text" placeholder="Search">
                    <button class="download" onclick="openModal()">+ Add Category</button>
                </div>

            </div>


            <form action="/admin/addcourse" method="POST" enctype="multipart/form-data">

                <div class="header">
                    <h2>Add New Course</h2>

                    <div>
                        <button type="button" class="draft">Save Draft</button>
                        <button type="submit" class="add">Add Course</button>
                    </div>
                </div>


                <div class="grid">

                    <!-- LEFT -->

                    <div>

                        <div class="box">

                            <h3>General Information</h3>

                            <label>Course Id</label>
                            <input type="text" name="courseId">

                            <label>Course Title</label>
                            <input type="text" name="courseName">

                            <label>Description</label>
                            <textarea name="description"></textarea>

                            <label>Instructor</label>
                            <input type="text" name="Instructor">

                        </div>


                        <div class="box">

                            <h3>Pricing And Seats</h3>

                            <label>Course Price</label>
                            <input type="number" name="courseFee">

                            <!-- <label>Available Seats</label>
                            <input type="number" name="seats"> -->

                        </div>

                    </div>

                    <!-- RIGHT -->

                    <div>

                        <div class="box">

                            <h3>Upload Thumbnail</h3>
                            <input type="file" name="coursesthumbnailImage">

                        </div>

                        <div class="box">

                            <h3>Category</h3>

                            <select name="courseCategory">
                                <option>Programming</option>
                                <option>Web Development</option>
                                <option>App Development</option>
                                <option>Data Science</option>
                                <option>Data Analysis</option>
                                <option>Design</option>
                                <option>Marketing</option>
                            </select>

                        </div>


                        <div class="box">

                            <!-- <h3>Course Details</h3>

                            <label>Course Duration</label>
                            <input type="text" name="courseDuration"> -->

                            <h3>Course Duration</h3>
                            <select name="courseDuration">
                                <option>12 Month</option>
                                <option>10 Month</option>
                                <option>6 Month</option>
                                <option>4 Month</option>
                            </select>


                            <label class="levellabel">Course Level</label>

                            <div class="level">
                                <label><input type="radio" name="level" value="Beginner"> Beginner</label>
                                <label><input type="radio" name="level" value="Intermediate"> Intermediate</label>
                                <label><input type="radio" name="level" value="Advanced"> Advanced</label>
                            </div>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>






    <!-- CATEGORY ADD MODAL -->

    <div id="categoryModal" class="modal">

        <div class="modal-content">

            <span class="close" onclick="closeModal()">&times;</span>

            <h2>Add Category</h2>

            <form action="/admin/addcategory" method="POST">

                <div class="form-group">
                    <label>Category Name</label>
                    <input type="text" name="categoryName" placeholder="Enter course category " required>
                </div>

                <button type="submit" class="submit-btn">Add Category</button>

            </form>

            <% for(let i=0;i<categories.length;i++){ %>
                <div class="inputsss">
                    <span>
                        <%= categories[i].categoryName %>
                    </span>
                    <a href="/deletecategory?Id=<%= categories[i]._id %>">Delete</a>
                </div>
                <% } %>
        </div>

    </div>






    <script>

        function openModal() {
            document.getElementById("categoryModal").style.display = "block";
        }

        function closeModal() {
            document.getElementById("categoryModal").style.display = "none";
        }

        window.onclick = function (event) {
            let modal = document.getElementById("categoryModal");
            if (event.target == modal) {
                modal.style.display = "none";
            }
        }

    </script>


</body>

</html>