<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Curriculum Syllabus – Eductix</title>
    <!-- Google Fonts: Geist & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/eductix.css">

    <style>
        .syllabus-page-container {
            max-width: 960px;
            margin: 40px auto 80px;
            padding: 0 20px;
        }

        .syllabus-card-main {
            background: #ffffff;
            border-radius: 24px;
            padding: 48px;
            border: 1px solid var(--eductix-border-card);
            box-shadow: var(--eductix-card-shadow);
        }

        .module-item {
            border: 1px solid var(--eductix-border-card);
            border-radius: 16px;
            margin-bottom: 20px;
            overflow: hidden;
            background: var(--eductix-card-mint);
            transition: all 0.25s ease;
        }

        .module-item:hover {
            border-color: var(--eductix-emerald-border);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 59, 45, 0.05);
        }

        .module-header-box {
            background: var(--eductix-forest);
            color: white;
            padding: 16px 24px;
            font-family: var(--font-heading);
            font-size: 17px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .module-topics-list {
            padding: 20px 24px;
            list-style: none;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .module-topics-list li {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14.5px;
            color: var(--eductix-slate);
        }

        .module-topics-list li .check-icon {
            color: var(--eductix-emerald);
            font-weight: 700;
        }

        @media (max-width: 600px) {
            .syllabus-card-main {
                padding: 28px 20px;
            }

            .module-topics-list {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <!-- OFFER BAR -->
    <div class="eductix-offer-bar">
        <span class="badge">Syllabus</span>
        <span>Download official course breakdown & project milestones.</span>
        <a href="/" style="text-decoration: underline; color: #fff; font-weight: 600;">Back to Home →</a>
    </div>

    <!-- NAVBAR -->
    <header class="eductix-nav-wrapper">
        <nav class="eductix-nav">
            <a href="/" class="eductix-brand">
                Eductix<span class="brand-dot"></span>
            </a>

            <ul class="eductix-nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/#course-section">Courses</a></li>
                <li><a href="/subscribe">Pricing</a></li>
                <li><a href="/#faq-section">FAQ</a></li>
            </ul>

            <div class="eductix-nav-actions">
                <a href="/cart" class="eductix-icon-btn" title="View Cart">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                </a>
                <a href="/#course-section" class="btn-eductix-primary">
                    <span>Explore</span>
                    <span class="icon-circle">↗</span>
                </a>
            </div>
        </nav>
    </header>

    <div class="syllabus-page-container">
        <div class="syllabus-card-main">
            <div class="pill-badge" style="margin-bottom: 16px;">
                <span class="pill-dot"></span> Full Curriculum Roadmap
            </div>

            <h1 class="section-title" style="font-size: 36px; margin-bottom: 8px;">
                Full Stack Development Syllabus
            </h1>

            <p style="color: var(--eductix-muted); font-size: 16px; margin-bottom: 36px;">
                A comprehensive, industry-aligned breakdown of every module, project, and milestone you will complete.
            </p>

            <!-- Module 1 -->
            <div class="module-item">
                <div class="module-header-box">
                    <span>Module 01: Modern HTML5 & CSS3 Design</span>
                    <span style="font-size: 13px; opacity: 0.8;">Week 1–2</span>
                </div>
                <ul class="module-topics-list">
                    <li><span class="check-icon">✓</span> Semantic HTML5 Architecture</li>
                    <li><span class="check-icon">✓</span> Advanced CSS Grid & Flexbox Layouts</li>
                    <li><span class="check-icon">✓</span> Responsive Design & Mobile First</li>
                    <li><span class="check-icon">✓</span> Transitions, Keyframes & Animations</li>
                </ul>
            </div>

            <!-- Module 2 -->
            <div class="module-item">
                <div class="module-header-box">
                    <span>Module 02: JavaScript & Modern ES6+</span>
                    <span style="font-size: 13px; opacity: 0.8;">Week 3–5</span>
                </div>
                <ul class="module-topics-list">
                    <li><span class="check-icon">✓</span> Async/Await, Promises & Fetch API</li>
                    <li><span class="check-icon">✓</span> DOM Manipulation & Event Handling</li>
                    <li><span class="check-icon">✓</span> Closures, Scope & OOP Principles</li>
                    <li><span class="check-icon">✓</span> Live Interactive Capstone Project</li>
                </ul>
            </div>

            <!-- Module 3 -->
            <div class="module-item">
                <div class="module-header-box">
                    <span>Module 03: Frontend Mastery (React & Next.js)</span>
                    <span style="font-size: 13px; opacity: 0.8;">Week 6–8</span>
                </div>
                <ul class="module-topics-list">
                    <li><span class="check-icon">✓</span> Component Architecture & State Hooks</li>
                    <li><span class="check-icon">✓</span> Client & Server-side Data Fetching</li>
                    <li><span class="check-icon">✓</span> Global State Management</li>
                    <li><span class="check-icon">✓</span> Performance Profiling & SEO</li>
                </ul>
            </div>

            <!-- Module 4 -->
            <div class="module-item">
                <div class="module-header-box">
                    <span>Module 04: Backend, Database & Cloud Deployment</span>
                    <span style="font-size: 13px; opacity: 0.8;">Week 9–12</span>
                </div>
                <ul class="module-topics-list">
                    <li><span class="check-icon">✓</span> Node.js, Express & RESTful APIs</li>
                    <li><span class="check-icon">✓</span> MongoDB Modeling & Mongoose Schemas</li>
                    <li><span class="check-icon">✓</span> JWT Authentication & Security</li>
                    <li><span class="check-icon">✓</span> Production Deployment & CI/CD</li>
                </ul>
            </div>

            <div style="margin-top: 36px; display: flex; gap: 14px; flex-wrap: wrap;">
                <a href="#download" onclick="alert('Downloading syllabus PDF...')" class="btn-eductix-primary">
                    <span>Download Full Syllabus PDF</span>
                    <span class="icon-circle">↓</span>
                </a>
                <a href="/#course-section" class="btn-eductix-secondary">
                    Browse Courses
                </a>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="eductix-footer">
        <div class="eductix-container">
            <div class="eductix-footer-grid">
                <div class="footer-brand">
                    <h3>Eductix<span style="color: var(--eductix-emerald);">.</span></h3>
                    <p>Build Skills. Build Your Future. A modern education ecosystem designed for ambitious learners worldwide.</p>
                </div>
                <div class="footer-col">
                    <h5>Navigation</h5>
                    <ul class="footer-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/#course-section">Courses</a></li>
                        <li><a href="/subscribe">Pricing</a></li>
                        <li><a href="/#faq-section">FAQ</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h5>Account</h5>
                    <ul class="footer-links">
                        <li><a href="/userlogin">Log in</a></li>
                        <li><a href="/usersignup">Sign up</a></li>
                        <li><a href="/cart">Cart</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h5>Admissions</h5>
                    <p style="font-size: 14px; color: #92b8a7;">Need help choosing your track? Connect with an educational advisor today.</p>
                </div>
            </div>

            <div class="eductix-footer-bottom">
                <p>© 2026 Eductix. All rights reserved.</p>
                <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="btn-back-to-top">
                    <span>Back To Top</span>
                    <span>↑</span>
                </button>
            </div>
        </div>
    </footer>
</body>

</html>