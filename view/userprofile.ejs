<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile – Eductix</title>
    <!-- Google Fonts: Geist & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/eductix.css">

    <style>
        .profile-page-wrapper {
            max-width: 1040px;
            margin: 40px auto 80px;
            padding: 0 24px;
        }

        .profile-header-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 36px;
            border: 1px solid var(--eductix-border-card);
            box-shadow: var(--eductix-card-shadow);
            display: flex;
            align-items: center;
            gap: 32px;
            margin-bottom: 24px;
        }

        .profile-avatar-wrap {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            overflow: hidden;
            border: 3px solid var(--eductix-emerald);
            box-shadow: 0 6px 20px rgba(13, 136, 60, 0.15);
            flex-shrink: 0;
            background: #eaf0ef;
        }

        .profile-avatar-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .profile-info-content h2 {
            font-family: var(--font-heading);
            font-size: 28px;
            font-weight: 700;
            color: var(--eductix-forest);
            margin-bottom: 6px;
        }

        .profile-tag-pill {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            background: var(--eductix-card-mint);
            color: var(--eductix-emerald);
            font-size: 13px;
            font-weight: 600;
            margin-right: 8px;
        }

        .profile-body-grid {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 24px;
        }

        .profile-sidebar-card,
        .profile-main-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 32px;
            border: 1px solid var(--eductix-border-card);
            box-shadow: var(--eductix-card-shadow);
        }

        .profile-section-title {
            font-family: var(--font-heading);
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--eductix-muted);
            margin-bottom: 16px;
        }

        .skills-tag-cloud {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .skill-tag {
            padding: 6px 14px;
            border-radius: 20px;
            background: var(--eductix-card-mint);
            border: 1px solid var(--eductix-border-subtle);
            color: var(--eductix-forest);
            font-size: 13px;
            font-weight: 500;
        }

        .info-data-row {
            display: flex;
            padding: 12px 0;
            border-bottom: 1px solid rgba(0, 59, 45, 0.06);
            font-size: 14.5px;
        }

        .info-data-row:last-child {
            border-bottom: none;
        }

        .info-data-label {
            width: 140px;
            color: var(--eductix-muted);
            font-weight: 500;
        }

        .info-data-val {
            color: var(--eductix-dark);
            font-weight: 600;
        }

        @media (max-width: 800px) {
            .profile-header-card {
                flex-direction: column;
                text-align: center;
            }

            .profile-body-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <!-- OFFER BAR -->
    <div class="eductix-offer-bar">
        <span class="badge">Student Profile</span>
        <span>Manage your personal info, certificates, and enrolled courses.</span>
        <a href="/" style="text-decoration: underline; color: #fff; font-weight: 600;">Home →</a>
    </div>

    <!-- NAVBAR -->
    <header class="eductix-nav-wrapper">
        <nav class="eductix-nav">
            <a href="/" class="eductix-brand">
                Eductix<span class="brand-dot"></span>
            </a>

            <ul class="eductix-nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/#course-section">Courses</a></li>
                <li><a href="/subscribe">Pricing</a></li>
                <li><a href="/#faq-section">FAQ</a></li>
            </ul>

            <div class="eductix-nav-actions">
                <a href="/cart" class="eductix-icon-btn" title="View Cart">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                </a>
                <a href="/#course-section" class="btn-eductix-primary">
                    <span>Explore</span>
                    <span class="icon-circle">↗</span>
                </a>
            </div>
        </nav>
    </header>

    <div class="profile-page-wrapper">
        <!-- Header Card -->
        <div class="profile-header-card">
            <div class="profile-avatar-wrap">
                <img src="/images/profileeee.png" alt="Mohammed Afsal" onerror="this.src='/images/userProfile.png'">
            </div>

            <div class="profile-info-content">
                <h2>Mohammed Afsal T</h2>
                <div style="margin-bottom: 12px;">
                    <span class="profile-tag-pill">Web Designer</span>
                    <span class="profile-tag-pill" style="background: rgba(0,59,45,0.06); color: var(--eductix-muted);">📍 Perinthalmanna, Kerala</span>
                </div>
                <div style="color: #f59e0b; margin-bottom: 16px; font-size: 15px;">
                    ★★★★☆ <span style="color: var(--eductix-muted); font-size: 13px;">(Certified Pro Student)</span>
                </div>
                <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                    <button class="btn-eductix-primary" style="padding: 10px 22px; font-size: 14px;" onclick="alert('Message window opening...')">
                        <span>Send Message</span>
                        <span class="icon-circle">↗</span>
                    </button>
                    <a href="/cart" class="btn-eductix-secondary" style="padding: 10px 22px; font-size: 14px;">
                        My Cart & Courses
                    </a>
                </div>
            </div>
        </div>

        <!-- Body Grid -->
        <div class="profile-body-grid">
            <!-- Sidebar: Experience & Skills -->
            <div class="profile-sidebar-card">
                <h4 class="profile-section-title">Experience & Learning</h4>
                <div style="margin-bottom: 24px;">
                    <div style="font-size: 15px; font-weight: 700; color: var(--eductix-dark);">Web & UI Developer</div>
                    <div style="font-size: 13.5px; color: var(--eductix-muted);">Eductix Learning Track</div>
                </div>

                <h4 class="profile-section-title">Skills & Competencies</h4>
                <div class="skills-tag-cloud">
                    <span class="skill-tag">UI/UX Design</span>
                    <span class="skill-tag">HTML5 / CSS3</span>
                    <span class="skill-tag">JavaScript ES6</span>
                    <span class="skill-tag">React.js</span>
                    <span class="skill-tag">Node.js</span>
                    <span class="skill-tag">Express.js</span>
                    <span class="skill-tag">MongoDB</span>
                </div>
            </div>

            <!-- Main Info -->
            <div class="profile-main-card">
                <h4 class="profile-section-title">Contact Information</h4>
                <div class="info-data-row">
                    <span class="info-data-label">Phone</span>
                    <span class="info-data-val">+91 9995917332</span>
                </div>
                <div class="info-data-row">
                    <span class="info-data-label">Email</span>
                    <span class="info-data-val">afsal@gmail.com</span>
                </div>
                <div class="info-data-row">
                    <span class="info-data-label">Portfolio</span>
                    <span class="info-data-val">www.afsalvpr.com</span>
                </div>
                <div class="info-data-row">
                    <span class="info-data-label">Address</span>
                    <span class="info-data-val">Vazhippara, Kerala, India</span>
                </div>

                <h4 class="profile-section-title" style="margin-top: 32px;">Student Details</h4>
                <div class="info-data-row">
                    <span class="info-data-label">Enrolled Track</span>
                    <span class="info-data-val">Full Stack Web Development</span>
                </div>
                <div class="info-data-row">
                    <span class="info-data-label">Status</span>
                    <span class="info-data-val" style="color: var(--eductix-emerald);">● Active Scholar</span>
                </div>
                <div class="info-data-row">
                    <span class="info-data-label">Membership</span>
                    <span class="info-data-val">Eductix Pro Member</span>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="eductix-footer">
        <div class="eductix-container">
            <div class="eductix-footer-bottom" style="padding-top: 0; border: none;">
                <p>© 2026 Eductix. All rights reserved.</p>
                <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="btn-back-to-top">
                    <span>Back To Top</span>
                    <span>↑</span>
                </button>
            </div>
        </div>
    </footer>
</body>

</html>