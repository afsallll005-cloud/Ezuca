<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Subscription Plans – Eductix</title>
    <!-- Google Fonts: Geist & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/eductix.css">
</head>

<body>
    <!-- OFFER BAR -->
    <div class="eductix-offer-bar">
        <span class="badge">Pricing</span>
        <span>Upgrade your career path with unlimited course access & mentorship.</span>
        <a href="/" style="text-decoration: underline; color: #fff; font-weight: 600;">Back to Home →</a>
    </div>

    <!-- NAVBAR -->
    <header class="eductix-nav-wrapper">
        <nav class="eductix-nav">
            <a href="/" class="eductix-brand">
                Eductix<span class="brand-dot"></span>
            </a>

            <ul class="eductix-nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/#course-section">Courses</a></li>
                <li><a href="/#program-section">Programs</a></li>
                <li><a href="/subscribe" class="active">Pricing</a></li>
                <li><a href="/#faq-section">FAQ</a></li>
            </ul>

            <div class="eductix-nav-actions">
                <a href="/cart" class="eductix-icon-btn" title="View Cart">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                </a>
                <a href="/userlogin" class="btn-eductix-outline">Log in</a>
                <a href="/usersignup" class="btn-eductix-primary">
                    <span>Sign up</span>
                    <span class="icon-circle">↗</span>
                </a>
            </div>
        </nav>
    </header>

    <!-- PRICING SECTION -->
    <section class="pricing-section" style="padding-top: 40px;">
        <div class="eductix-container">
            <div class="section-header text-center">
                <span class="section-tagline">Transparent Pricing</span>
                <h1 class="section-title">Flexible Plans for Every Learner</h1>
                <p class="section-desc">Choose a plan that fits your career goals and grow at your own pace with verified certificates and mentorship.</p>
            </div>

            <div class="pricing-grid">
                <!-- Basic Plan -->
                <div class="pricing-card standard">
                    <div class="pricing-header">
                        <h4 class="pricing-tier-name">Basic Plan</h4>
                        <div class="pricing-price-wrap">
                            <span class="pricing-amount">₹499</span>
                            <span class="pricing-period">/ month</span>
                        </div>
                        <p class="pricing-desc">Perfect for beginners starting their learning journey.</p>
                    </div>

                    <ul class="pricing-features-list">
                        <li><span class="pricing-check-icon">✓</span> Access to 5 foundation courses</li>
                        <li><span class="pricing-check-icon">✓</span> Community forum access</li>
                        <li><span class="pricing-check-icon">✓</span> Downloadable study materials</li>
                        <li><span class="pricing-check-icon">✓</span> Course completion certificates</li>
                        <li class="disabled"><span class="pricing-check-icon">✕</span> 1-on-1 mentor code reviews</li>
                        <li class="disabled"><span class="pricing-check-icon">✕</span> Job placement assistance</li>
                    </ul>

                    <button class="btn-eductix-secondary" style="width: 100%; justify-content: center;" onclick="alert('Subscription feature initialized')">
                        Choose Basic
                    </button>
                </div>

                <!-- Pro Plan (Featured) -->
                <div class="pricing-card featured">
                    <div style="position: absolute; top: -14px; right: 24px; background: #ffffff; color: var(--eductix-emerald); font-size: 11.5px; font-weight: 700; padding: 4px 14px; border-radius: 20px; text-transform: uppercase;">
                        Most Popular
                    </div>

                    <div class="pricing-header">
                        <h4 class="pricing-tier-name">Pro Plan</h4>
                        <div class="pricing-price-wrap">
                            <span class="pricing-amount">₹999</span>
                            <span class="pricing-period">/ month</span>
                        </div>
                        <p class="pricing-desc">Best for learners who want full access, projects, and mentorship.</p>
                    </div>

                    <ul class="pricing-features-list">
                        <li><span class="pricing-check-icon">✓</span> Full access to all courses</li>
                        <li><span class="pricing-check-icon">✓</span> Hands-on real world portfolio projects</li>
                        <li><span class="pricing-check-icon">✓</span> Downloadable templates & code</li>
                        <li><span class="pricing-check-icon">✓</span> Industry-recognized certificates</li>
                        <li><span class="pricing-check-icon">✓</span> Monthly 1-on-1 mentorship session</li>
                        <li><span class="pricing-check-icon">✓</span> Priority support response</li>
                    </ul>

                    <button class="btn-eductix-primary" style="background: white; color: var(--eductix-forest) !important; width: 100%; justify-content: center; box-shadow: 0 4px 20px rgba(0,0,0,0.15);" onclick="alert('Subscription feature initialized')">
                        <span>Subscribe Pro</span>
                        <span class="icon-circle" style="background: var(--eductix-emerald); color: white;">↗</span>
                    </button>
                </div>

                <!-- Premium Plan -->
                <div class="pricing-card standard">
                    <div class="pricing-header">
                        <h4 class="pricing-tier-name">Premium Career Plan</h4>
                        <div class="pricing-price-wrap">
                            <span class="pricing-amount">₹1,499</span>
                            <span class="pricing-period">/ month</span>
                        </div>
                        <p class="pricing-desc">For ambitious individuals aiming for immediate job placement.</p>
                    </div>

                    <ul class="pricing-features-list">
                        <li><span class="pricing-check-icon">✓</span> Everything in Pro plan</li>
                        <li><span class="pricing-check-icon">✓</span> Weekly 1-on-1 mentor guidance</li>
                        <li><span class="pricing-check-icon">✓</span> Resume & portfolio review</li>
                        <li><span class="pricing-check-icon">✓</span> Mock interviews with tech leads</li>
                        <li><span class="pricing-check-icon">✓</span> Direct job referral assistance</li>
                        <li><span class="pricing-check-icon">✓</span> Lifetime community VIP access</li>
                    </ul>

                    <button class="btn-eductix-secondary" style="width: 100%; justify-content: center;" onclick="alert('Subscription feature initialized')">
                        Choose Premium
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="eductix-footer">
        <div class="eductix-container">
            <div class="eductix-footer-grid">
                <div class="footer-brand">
                    <h3>Eductix<span style="color: var(--eductix-emerald);">.</span></h3>
                    <p>Build Skills. Build Your Future. A modern education ecosystem designed for ambitious learners worldwide.</p>
                </div>
                <div class="footer-col">
                    <h5>Navigation</h5>
                    <ul class="footer-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/#course-section">Courses</a></li>
                        <li><a href="/subscribe">Pricing</a></li>
                        <li><a href="/#faq-section">FAQ</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h5>Account</h5>
                    <ul class="footer-links">
                        <li><a href="/userlogin">Log in</a></li>
                        <li><a href="/usersignup">Sign up</a></li>
                        <li><a href="/cart">Cart</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h5>Need Help?</h5>
                    <p style="font-size: 14px; color: #92b8a7;">Contact our admissions team anytime for advice on choosing the right path.</p>
                </div>
            </div>

            <div class="eductix-footer-bottom">
                <p>© 2026 Eductix. All rights reserved.</p>
                <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="btn-back-to-top">
                    <span>Back To Top</span>
                    <span>↑</span>
                </button>
            </div>
        </div>
    </footer>
</body>

</html>